erDiagram
    %% =======================================================
    %% GHIDORA TRANSPORT - Online Booking Transport Platform
    %% Entity-Relationship Model (Black & White Academic Edition)
    %% All Key Types: PK (Primary), FK (Foreign), UK (Unique / Candidate)
    %% =======================================================

    USER ||--o{ BOOKING : "places / books (1 to 0..*)"
    USER ||--o{ REVIEW : "submits (1 to 0..*)"
    BOOKING ||--o{ BOOKING_ATTACHMENT : "includes (1 to 0..*)"
    BOOKING ||--o{ PAYMENT_REQUEST : "generates (1 to 0..*)"
    PAYMENT_REQUEST ||--o| RECEIPT : "issues (1 to 0..1)"
    BOOKING }o--o| DRIVER : "assigns (0..* to 0..1)"
    DRIVER ||--|| VEHICLE : "operates / owns (1 to 1)"
    BOOKING |o--o{ REVIEW : "receives feedback (0..1 to 0..*)"
    BOOKING }o--o| PREDEFINED_ROUTE_FARE : "applies fixed fare (0..* to 0..1)"
    BOOKING }o--o| PREDEFINED_ROUTE_DISTANCE : "measures fixed distance (0..* to 0..1)"

    USER {
        bigint id PK "Primary Key (Surrogate AutoField)"
        varchar username UK "Unique Candidate Key (Login Handle)"
        varchar email "Customer Email Address"
        varchar first_name "First Name"
        varchar last_name "Last Name"
        boolean is_staff "Staff / Dispatcher Role Flag"
        datetime date_joined "Account Registration Timestamp"
    }

    BOOKING {
        bigint id PK "Primary Key (Internal Surrogate AutoField)"
        varchar booking_id UK "Unique Reference Tracking Code (e.g. GT4592)"
        bigint user_id FK "Foreign Key -> auth_user.id (Nullable for Guests)"
        bigint assigned_driver_id FK "Foreign Key -> drivers_driver.id (Nullable)"
        varchar name "Customer Full Name"
        varchar phone "Customer Primary Mobile Number"
        varchar email "Customer Contact Email (Nullable)"
        varchar pickup "Pickup Origin Address / Village / City"
        varchar destination "Destination Address / City"
        float pickup_lat "Origin Latitude (GPS Coordinate)"
        float pickup_lng "Origin Longitude (GPS Coordinate)"
        float destination_lat "Destination Latitude (GPS Coordinate)"
        float destination_lng "Destination Longitude (GPS Coordinate)"
        varchar duration_text "Google Directions Travel Duration"
        float distance "Route Road Distance in KM"
        varchar distance_source "Calculation Source (Google / Manual / Predefined)"
        float fare "Base Transportation Trip Fare in INR"
        varchar fare_type "Fare Calculation Model (Predefined / Distance)"
        float toll_charges "Toll Plaza Highway Fees (Nullable)"
        float parking_charges "City Parking / Permit Fees (Nullable)"
        varchar vehicle_type "Vehicle Category (Mahindra Pickup / Bolero)"
        varchar trip_type "Journey Type (One Way / Round Trip)"
        varchar cargo_type "Type of Goods (Agricultural / Industrial)"
        decimal weight_value "Consignment Weight"
        varchar weight_unit "Measurement Unit (kg / ton)"
        varchar status "Trip Lifecycle (Pending, Confirmed, Completed, Cancelled)"
        varchar payment_status "Settlement State (Pending, Paid, Partial, Failed)"
        datetime booking_date "Booking Creation Timestamp"
        date journey_date "Scheduled Transportation Date"
    }

    DRIVER {
        bigint id PK "Primary Key (Surrogate AutoField)"
        varchar name "Driver Legal Full Name"
        varchar mobile UK "Unique 10-Digit Mobile Number"
        varchar license_number UK "Unique Commercial Driving License"
        varchar address "Driver Residence Address"
        int experience_years "Commercial Driving Experience (Years)"
        varchar status "Operational Status (available / busy)"
        boolean is_default "Auto-Assignment Default Driver Flag"
        datetime created_at "Registration Timestamp"
    }

    VEHICLE {
        bigint id PK "Primary Key (Surrogate AutoField)"
        bigint driver_id FK,UK "Foreign Key [One-to-One] -> drivers_driver.id"
        varchar vehicle_number UK "Unique RTO Registration Number (e.g. CG05 AB 1234)"
        varchar vehicle_type "Vehicle Model / Category (Mahindra Pickup)"
        varchar capacity "Rated Payload Carrying Capacity (e.g. 1 Ton)"
        varchar rc_number "Vehicle Registration Certificate Number"
    }

    PAYMENT_REQUEST {
        bigint id PK "Primary Key (Surrogate AutoField)"
        varchar payment_id UK "Unique Payment Reference Code (PAY-XXXXXX)"
        bigint booking_id FK "Foreign Key -> booking_booking.id"
        bigint created_by_id FK "Foreign Key -> auth_user.id (Dispatcher)"
        varchar payment_type "Payment Nature (advance / full / remaining)"
        decimal amount "Requested Invoice Amount in INR"
        decimal total_fare "Total Booking Agreed Fare in INR"
        decimal amount_already_paid "Previously Received Payment Amount"
        varchar status "Status (pending / submitted / verified / rejected)"
        datetime due_date "Payment Expiry Timestamp"
        varchar preferred_method "Payment Mode (qr / upi / bank)"
        varchar gateway "Settlement Channel (manual / razorpay / phonepe)"
        datetime created_at "Request Creation Timestamp"
    }

    RECEIPT {
        bigint id PK "Primary Key (Surrogate AutoField)"
        varchar receipt_id UK "Unique Receipt Number (RCPT-XXXXXX)"
        bigint payment_request_id FK,UK "Foreign Key [One-to-One] -> payments_paymentrequest.id"
        varchar pdf_file "Server Stored PDF Receipt File Path"
        datetime generated_at "Generation Timestamp"
        varchar sent_to_email "Recipient Customer Email Address"
        boolean is_sent "Automated Email Dispatch Status"
    }

    BOOKING_ATTACHMENT {
        bigint id PK "Primary Key (Surrogate AutoField)"
        bigint booking_id FK "Foreign Key -> booking_booking.id"
        varchar attachment_type "Media Type (voice / photo / video)"
        varchar file "Uploaded Media Storage Path"
        datetime uploaded_at "Upload Timestamp"
    }

    REVIEW {
        bigint id PK "Primary Key (Surrogate AutoField)"
        bigint booking_id FK "Foreign Key -> booking_booking.id (Nullable)"
        bigint user_id FK "Foreign Key -> auth_user.id (Nullable)"
        varchar guest_name "Guest Reviewer Name (for Unauthenticated Users)"
        int rating "Star Rating (1 to 5 Stars)"
        text comment "Detailed Customer Feedback Review"
        varchar service_used "Transport Service Category Utilized"
        boolean is_approved "Admin Moderation Approval Status"
        boolean is_verified "Verified Customer Booking Badge"
        datetime created_at "Feedback Submission Timestamp"
    }

    PREDEFINED_ROUTE_FARE {
        bigint id PK "Primary Key (Surrogate AutoField)"
        varchar from_location "Origin Village / Town / Hub"
        varchar to_location "Destination Village / Town / Hub"
        decimal fixed_fare "Pre-Agreed Fixed One-Way Fare in INR"
        decimal double_trip_fare "Pre-Agreed Round Trip Fare in INR"
        decimal distance_km "Standardized Route Road Distance in KM"
        boolean same_direction_both "Bi-directional Route Validity (Both Ways)"
        boolean is_active "Route Operational Status"
    }

    PREDEFINED_ROUTE_DISTANCE {
        bigint id PK "Primary Key (Surrogate AutoField)"
        varchar from_location "Origin Village / Town / Hub"
        varchar to_location "Destination Village / Town / Hub"
        decimal distance_km "Officially Measured Route Distance in KM"
        boolean same_direction_both "Bi-directional Distance Validity"
        boolean is_active "Distance Entry Operational Status"
    }
